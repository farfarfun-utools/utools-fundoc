{
  "name": "utools-fundoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm run sync:vditor && vite",
    "build": "pnpm run sync:vditor && pnpm run build:preload && vite build",
    "build:preload": "vite build --config vite.preload.config.ts",
    "preview": "vite preview",
    "sync:vditor": "node scripts/sync-vditor.mjs",
    "test": "pnpm run build:preload && vitest run",
    "e2e": "node scripts/e2e.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --no-fix --quiet",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "nanoid": "^5.1.6",
    "vditor": "^4.0.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "utools-api-types": "^8.0.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.8"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=12"
  }
}
